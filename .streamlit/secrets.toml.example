# FlashRFP.AI — Streamlit Cloud Secrets Template
# ─────────────────────────────────────────────
# In Streamlit Cloud → App Settings → Secrets,
# paste the contents below (without the # comments) and fill in your real values.

# ── LLM API Keys ──────────────────────────────
GEMINI_API_KEY = "your_gemini_api_key_here"
GROQ_API_KEY = ""
OPENROUTER_API_KEY = ""
ACTIVE_PROVIDER = "Google Gemini"
DEMO_MODE = "False"

# ── Admin Credentials ─────────────────────────
# Username to log into the Admin Console
ADMIN_USERNAME = "admin"

# bcrypt hash of your admin password.
# Default below = hash of 'admin123'
# To generate a new hash for a custom password, run:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YourPassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH = "$2b$12$EZTELUZjs78b28YedCXD3OgAl5/SvQcVtUsy48huU5THS4MzR2CBe"

# ── Optional: Supabase ────────────────────────
# Leave blank to use local JSON storage (default)
SUPABASE_URL = ""
SUPABASE_KEY = ""
